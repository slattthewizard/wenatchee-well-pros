        </ul>
      </div>
      <!-- Contact -->
      <div>
        <p style="font-family:'Zilla Slab',Georgia,serif;font-size:16px;font-weight:700;color:#F6F3ED;margin-bottom:16px;letter-spacing:0.02em;">Contact</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;">
          <li style="display:flex;align-items:flex-start;gap:10px;">
            <svg width="15" height="15" style="flex-shrink:0;margin-top:2px;color:#8FD0EA;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.5 12 19.79 19.79 0 0 1 1.1 3.18a2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.27a16 16 0 0 0 7.82 7.82l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+15095550142" class="footer-link">(509) 555-0142</a>
          </li>
          <li style="display:flex;align-items:flex-start;gap:10px;">
            <svg width="15" height="15" style="flex-shrink:0;margin-top:2px;color:#8FD0EA;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
            <a href="mailto:info@wenatcheewellpros.com" class="footer-link">info@wenatcheewellpros.com</a>
