<!-- SERVICES -->
<section id="services" style="padding:80px 24px;">
  <div style="max-width:1100px;margin:0 auto;">
    <span class="section-tag">What We Do</span>
    <h2 class="section-heading" style="font-size:clamp(24px,3.5vw,38px);margin:0 0 32px;">Well Pump &amp; Water System Services</h2>
    <div class="svc-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
      <a href="/well-pump-repair-wenatchee/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);transition:box-shadow 0.2s, transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 28px rgba(14,77,110,0.14)'" onmouseout="this.style.transform='';this.style.boxShadow='0 2px 8px rgba(14,77,110,0.06)'">
        <h3 style="font-family:'Zilla Slab',Georgia,serif;font-size:20px;font-weight:700;color:#0E4D6E;margin:0 0 10px;">Well Pump Repair</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">Low pressure, sputtering faucets, or a pump that won't shut off? We diagnose the real problem and fix it the same day whenever we can.</p>
        <span style="font-size:13px;font-weight:600;color:#B96A2C;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/well-pump-replacement-wenatchee/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);transition:box-shadow 0.2s, transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 28px rgba(14,77,110,0.14)'" onmouseout="this.style.transform='';this.style.boxShadow='0 2px 8px rgba(14,77,110,0.06)'">
        <h3 style="font-family:'Zilla Slab',Georgia,serif;font-size:20px;font-weight:700;color:#0E4D6E;margin:0 0 10px;">Well Pump Replacement</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">When a pump is past saving, we'll size the right submersible or jet pump for your well depth and water needs. Most replacements are done in a single visit.</p>
        <span style="font-size:13px;font-weight:600;color:#B96A2C;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/pressure-tank-replacement-wenatchee/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);transition:box-shadow 0.2s, transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 28px rgba(14,77,110,0.14)'" onmouseout="this.style.transform='';this.style.boxShadow='0 2px 8px rgba(14,77,110,0.06)'">
        <h3 style="font-family:'Zilla Slab',Georgia,serif;font-size:20px;font-weight:700;color:#0E4D6E;margin:0 0 10px;">Pressure Tank Service</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">A waterlogged or failing pressure tank makes your pump short cycle and burn out early. We repair, recharge, and replace tanks so your system runs steady.</p>
        <span style="font-size:13px;font-weight:600;color:#B96A2C;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
      <a href="/emergency-well-service-wenatchee/" style="display:flex;flex-direction:column;background:#fff;border:1px solid #e3ded4;border-radius:12px;padding:30px 26px;text-decoration:none;box-shadow:0 2px 8px rgba(14,77,110,0.06);transition:box-shadow 0.2s, transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 28px rgba(14,77,110,0.14)'" onmouseout="this.style.transform='';this.style.boxShadow='0 2px 8px rgba(14,77,110,0.06)'">
        <h3 style="font-family:'Zilla Slab',Georgia,serif;font-size:20px;font-weight:700;color:#0E4D6E;margin:0 0 10px;">Emergency No-Water Service</h3>
        <p style="font-size:14.5px;line-height:1.7;color:#555;margin:0 0 18px;flex:1;">No water is not a wait-until-Monday problem, especially in a Wenatchee summer. Call any hour, any day, and we'll get a tech headed your way.</p>
        <span style="font-size:13px;font-weight:600;color:#B96A2C;letter-spacing:0.04em;text-transform:uppercase;">Learn More &#8594;</span>
      </a>
    </div>
  </div>
</section>
