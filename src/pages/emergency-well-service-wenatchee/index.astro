  <div style="max-width:1100px;margin:0 auto;">
    <span class="section-tag">What We Handle</span>
    <h2 class="section-heading" style="font-size:clamp(22px,3vw,32px);margin:0 0 28px;">Service Highlights</h2>
    <div class="feat-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
